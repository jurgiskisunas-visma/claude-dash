# Path to your Claude Code state directory. Defaults to %USERPROFILE%\.claude.
# CLAUDE_HOME=C:\Users\you\.claude

# === Jira (optional — powers the per-session Jira tab) ===
# Host only, no protocol. Atlassian Cloud looks like "your-org.atlassian.net";
# a self-hosted Server / Data Center install is just its hostname.
JIRA_DOMAIN=
# Cloud: your Atlassian account email (used for Basic auth with the API token).
# Server / DC: usually ignored — those accept a Bearer personal access token.
JIRA_EMAIL=
# Cloud: https://id.atlassian.com/manage-profile/security/api-tokens
# Server / DC: Profile -> Personal Access Tokens
JIRA_API_TOKEN=
# Your workflow's statuses in order, comma-separated. Drives the back/forward
# transition buttons on the Jira tab. Defaults to: To Do, In Progress, In Review, Done
# JIRA_STATUS_LADDER=Open,In Progress,In Review,Done
